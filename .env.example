ABA_APP_NAME="Autonomous Browser Agent"
ABA_ENVIRONMENT=local
ABA_LOG_LEVEL=INFO
ABA_SQLITE_PATH=data/agent.sqlite3
ABA_OLLAMA_BASE_URL=http://localhost:11434
ABA_DEFAULT_PLANNER_MODEL=gemma4
ABA_DEFAULT_CODER_MODEL=qwen2.5-coder
ABA_USE_OLLAMA_PLANNER=false
ABA_BROWSER_HEADLESS=false
ABA_BROWSER_ACTION_TIMEOUT_SECONDS=20
ABA_RUN_TIMEOUT_SECONDS=900
ABA_MAX_STEP_ATTEMPTS=3
